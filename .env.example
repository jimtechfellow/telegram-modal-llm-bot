# Documentation only: the application does NOT automatically load .env files.
# Keep real values out of this file, Git, shell history and command-line arguments.
# Inject secrets into the process environment using your own secret manager.

# Required for running the Telegram polling bot:
TELEGRAM_BOT_TOKEN=

# Required for deployment; copied into this app's Modal Secret for CPU downloads:
HF_TOKEN=

# Optional when using Modal SDK credentials instead of `modal setup`:
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# If set, this must match modal_environment in your private config.toml:
MODAL_ENVIRONMENT=main
